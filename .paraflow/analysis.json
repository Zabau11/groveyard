{
  "version": 1,
  "packageManager": "npm",
  "verify": [
    "npm run typecheck",
    "npm run build"
  ],
  "modules": [
    {
      "name": "commands",
      "path": "src/commands",
      "kind": "source"
    },
    {
      "name": "generators",
      "path": "src/generators",
      "kind": "source"
    },
    {
      "name": "schemas",
      "path": "src/schemas",
      "kind": "source"
    },
    {
      "name": "validation",
      "path": "src/validation",
      "kind": "source"
    }
  ],
  "sharedFiles": [
    "package-lock.json",
    "package.json",
    "src/generators/routes.ts",
    "src/index.ts",
    "tsconfig.json"
  ],
  "protected": [
    ".paraflow/**",
    "contracts/**",
    "src/generated/**",
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lockb"
  ],
  "notes": [
    "Shared files were detected. Normal agents should not edit these directly unless explicitly approved."
  ]
}
