{
  "name": "groveyard-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Groveyard MCP server, CLI, and website.",
  "workspaces": [
    "packages/*",
    "website"
  ],
  "scripts": {
    "build": "npm run build -w @groveyard/mcp && npm run build -w @groveyard/site",
    "build:groveyard": "npm run build -w @groveyard/mcp",
    "build:web": "npm run build -w @groveyard/site",
    "dev:groveyard": "npm run dev -w @groveyard/mcp",
    "dev:web": "npm run dev -w @groveyard/site",
    "test": "npm run test -w @groveyard/mcp",
    "test:groveyard": "npm run test -w @groveyard/mcp",
    "typecheck": "npm run typecheck -w @groveyard/mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
