{
  "name": "paraflow-orchestrator",
  "version": "0.1.0",
  "description": "Task contracts that keep AI coding agents inside their lane.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "paraflow": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:groveyard": "npm run build -w @groveyard/mcp",
    "build:worktree-mcp": "npm run build -w @groveyard/mcp",
    "dev": "tsx src/index.ts",
    "dev:groveyard": "npm run dev -w @groveyard/mcp",
    "dev:worktree-mcp": "npm run dev -w @groveyard/mcp",
    "test:groveyard": "npm run test -w @groveyard/mcp",
    "test:worktree-mcp": "npm run test -w @groveyard/mcp",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@types/react": "^19.2.17",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.2",
    "ink": "^7.1.0",
    "minimatch": "^10.0.1",
    "react": "^19.2.7",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@groveyard/mcp": "^0.1.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
